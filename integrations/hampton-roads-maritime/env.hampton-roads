# Hampton Roads Maritime — add to your Anansi .env
# Free key: https://aisstream.io  (server-side only; never prefix with VITE_)
AISSTREAM_API_KEY=

# Only stream ships in Hampton Roads, the lower Chesapeake Bay and the capes.
# Format: [[[south_lat, west_lon], [north_lat, east_lon]]]
AISSTREAM_BOUNDING_BOXES=[[[36.75,-76.75],[37.45,-75.65]]]

# A regional box can be quiet for a few minutes overnight; only flag the feed
# as stale after 5 minutes of silence.
AISSTREAM_SILENCE_TIMEOUT_MS=300000
