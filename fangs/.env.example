# Copy to .env (gitignored) or export in your shell. NOTHING here is required: every feed/LLM degrades honestly without its key.
# Keys are read server-side only and are never sent to the browser or written to any response.
ABUSECH_AUTH_KEY=        # abuse.ch (ThreatFox + URLhaus) free Auth-Key
CLOUDFLARE_API_TOKEN=    # Cloudflare Radar (read-only)
GREYNOISE_API_KEY=       # GreyNoise Community
OTX_API_KEY=             # AlienVault OTX
GROQ_API_KEY=            # fast free LLM for narration (primary)
CEREBRAS_API_KEY=        # fast free LLM for narration (fallback)
# GROQ_MODEL=llama-3.1-8b-instant   CEREBRAS_MODEL=llama3.1-8b   (model names change; override here)
# FANGS_LLM_RPM=20       narration budget, calls/minute (free tiers are rate limited)
# PORT=8757  HOST=127.0.0.1  FANGS_OFFLINE=1 (bundled snapshot only)  FANGS_NO_ENRICH=1
